{
  "name": "tolmaal",
  "version": "2.8.3",
  "private": true,
  "type": "module",
  "description": "तौल-माल (TolMaal by Solidrix) — हर दुकान और व्यापार का अपना हिसाब (Chakki, Mandi, Feeds, Oil Mill, Trading)",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev --port 8787 --local",
    "db:init": "wrangler d1 execute chakki-book --local --file=schema.sql",
    "check": "find src public/js -name '*.js' -exec node --check {} +",
    "android:add": "npx cap add android",
    "android:sync": "rm -f public/tolmaal.apk android/app/src/main/assets/public/tolmaal.apk && npx cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "qrcode-generator": "^2.0.4"
  }
}
