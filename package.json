{
  "name": "chakki-book",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "हर दुकान का अपना हिसाब — multi-tenant chakki / small-business billing",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev --port 8787 --local",
    "db:init": "wrangler d1 execute chakki-book --local --file=schema.sql",
    "check": "node --check src/worker.js && node --check public/app.js",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
